# Copy this file to ".env" (same folder) and fill in the empty values.
# NEVER commit ".env" to Git.

# development | production
ENVIRONMENT=development

# --- MongoDB Atlas ---------------------------------------------------------
# Paste your Atlas connection string here (replace the <...> parts).
# Shape: mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER_HOST>/authentication_db?retryWrites=true&w=majority
MONGODB_URL=
DATABASE_NAME=authentication_db

# --- JWT -------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- URLs / CORS -----------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Comma-separated list of allowed browser origins. Empty = use FRONTEND_URL only.
CORS_ORIGINS=

# --- Email (SMTP) ----------------------------------------------------------
# Leave SMTP_* empty in development to print emails to the backend console instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Auth Practice

EMAIL_VERIFICATION_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=15

# --- Refresh-token cookie --------------------------------------------------
# Local http://localhost: COOKIE_SECURE=false, COOKIE_SAMESITE=lax
# Production HTTPS:       COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

RATE_LIMIT_ENABLED=true
